OC_DATA_DIR=.data
OC_BIND=127.0.0.1:8080
OC_SERVER_URL=http://127.0.0.1:8080
OC_HTTP_PORT=8080
# OC_API_KEY is needed only by authenticated clients; never commit real tokens.
OC_API_KEY=

# The binary reads process environment; it does not load .env automatically.
# Compose reads this file when copied to .env.
OC_ENABLE_MODELS=false
OC_MODEL_BASE_URL=
OC_MODEL_API_KEY=
OC_EMBEDDING_MODEL=
OC_EMBEDDING_DIMENSION=0
OC_EXTRACTION_MODEL=
