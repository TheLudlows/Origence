OC_DATA_DIR=.data
OC_BIND=127.0.0.1:8080
OC_SERVER_URL=http://127.0.0.1:8080
OC_HTTP_PORT=8080
# Public HTTPS origin for /mcp when a TLS reverse proxy preserves the external Host.
OC_MCP_PUBLIC_ORIGIN=
# OC_API_KEY is needed only by authenticated clients; never commit real tokens.
OC_API_KEY=

# The binary reads process environment; it does not load .env automatically.
# Compose reads this file when copied to .env.
OC_ENABLE_MODELS=false
# Shared endpoint and credentials for models without a dedicated URL.
OC_MODEL_BASE_URL=
OC_MODEL_API_KEY=
# A dedicated URL uses only the API key in its own group.
OC_EMBEDDING_BASE_URL=
OC_EMBEDDING_API_KEY=
OC_EMBEDDING_MODEL=
OC_EMBEDDING_DIMENSION=0
OC_EXTRACTION_BASE_URL=
OC_EXTRACTION_API_KEY=
OC_EXTRACTION_MODEL=
# Optional first-start secret: oc_admin_ followed by 64 lowercase hex digits.
# OC_DEPLOYMENT_ADMIN_KEY=

# Cloud / Compose retrieval connects to the remote AnySeek HTTPS origin.
# Workspace collections are created on first use.
# Authenticated tenant_id -> namespace; workspace_id -> ws_<UUID without hyphens>.
OC_ANYSEEK_URL=
OC_ANYSEEK_API_KEY=
