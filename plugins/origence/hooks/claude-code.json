{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 3,
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/hooks/entry.mjs",
              "claude-code"
            ],
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 3,
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/hooks/entry.mjs",
              "claude-code"
            ],
            "onFailure": "continue"
          }
        ],
        "matcher": "^(Bash|Edit|Write|Agent|mcp__(origence|plugin_origence_origence)__(context_search|context_get|context_run_create|context_run_report|context_run_prepare|context_run_get))$"
      }
    ],
    "PostToolUseFailure": [
