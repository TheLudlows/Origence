{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 3,
            "command": "node --disable-warning=ExperimentalWarning -e \"require(require('node:path').join(process.env.PLUGIN_ROOT, 'hooks', 'entry.mjs')).run('codex')\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 3,
            "command": "node --disable-warning=ExperimentalWarning -e \"require(require('node:path').join(process.env.PLUGIN_ROOT, 'hooks', 'entry.mjs')).run('codex')\""
          }
        ],
        "matcher": "^(Bash|apply_patch|mcp__(origence|plugin_origence_origence)__(context_search|context_get|context_run_create|context_run_report|context_run_prepare|context_run_get))$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 3,
            "command": "node --disable-warning=ExperimentalWarning -e \"require(require('node:path').join(process.env.PLUGIN_ROOT, 'hooks', 'entry.mjs')).run('codex')\""
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 3,
            "command": "node --disable-warning=ExperimentalWarning -e \"require(require('node:path').join(process.env.PLUGIN_ROOT, 'hooks', 'entry.mjs')).run('codex')\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 3,
            "command": "node --disable-warning=ExperimentalWarning -e \"require(require('node:path').join(process.env.PLUGIN_ROOT, 'hooks', 'entry.mjs')).run('codex')\""
          }
        ]
      }
    ]
  }
}
